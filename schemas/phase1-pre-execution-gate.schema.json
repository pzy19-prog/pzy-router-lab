{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pzy19-prog.github.io/pzy-router-lab/schemas/phase1-pre-execution-gate.schema.json",
  "title": "Router Lab Phase 1 Pre-Execution Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_kind", "status", "execution_authorized", "repository", "branch", "base_commit", "issue_5", "issue_3", "as_of", "fresh_read", "claim_hierarchy", "heldout_governance", "candidate_registry", "adapter_runner_executor_identity", "environment_plan", "resource_budget", "stop_conditions", "unresolved_items"
  ],
  "properties": {
    "schema_version": {"const": "phase1-pre-execution-gate-v1"},
    "record_kind": {"const": "ROUTER_LAB_PHASE1_PRE_EXECUTION_GATE"},
    "status": {"const": "PRE_EXECUTION_GATE_READY_FOR_REVIEW"},
    "execution_authorized": {"const": false},
    "repository": {"const": "pzy19-prog/pzy-router-lab"},
    "branch": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "issue_5": {"type": "string", "format": "uri"},
    "issue_3": {"type": "string", "format": "uri"},
    "as_of": {"type": "string", "format": "date"},
    "fresh_read": {"type": "object", "required": ["main_commit", "current_branch_commit", "worktree_initially_clean", "issue_5_status", "issue_3_status", "phase0_design", "playbook_preflight"], "properties": {"main_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "current_branch_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "worktree_initially_clean": {"const": true}, "issue_5_status": {"type": "string"}, "issue_3_status": {"type": "string"}, "phase0_design": {"type": "string"}, "playbook_preflight": {"type": "string"}}, "additionalProperties": false},
    "claim_hierarchy": {"type": "object", "required": ["formal_inferential_benchmark", "pilot_type", "pilot_scope", "tracks", "sample_size", "alpha_power_and_thresholds", "unknown_denominator_rule", "multiplicity", "descriptive_only"], "properties": {"formal_inferential_benchmark": {"const": "NOT_YET_JUSTIFIED"}, "pilot_type": {"const": "NON-INFERENTIAL PILOT"}, "pilot_scope": {"type": "string"}, "tracks": {"type": "object", "required": ["A_controlled_routing_comparison", "B_end_to_end_system_comparison"], "properties": {"A_controlled_routing_comparison": {"$ref": "#/$defs/track"}, "B_end_to_end_system_comparison": {"$ref": "#/$defs/track"}}, "additionalProperties": false}, "sample_size": {"type": "string"}, "alpha_power_and_thresholds": {"type": "string"}, "unknown_denominator_rule": {"type": "string"}, "multiplicity": {"type": "string"}, "descriptive_only": {"type": "array", "items": {"type": "string"}, "minItems": 1}}, "additionalProperties": false},
    "heldout_governance": {"type": "object", "required": ["formal_heldout_created", "formal_heldout_content_present", "status", "custodian_role", "access", "population", "strata", "sample_frame", "generation_protocol", "sealing", "manifest_fields", "case_id", "digests", "overlap_contamination", "blind_route_gold", "blind_task_outcome", "unknown_handling", "unseal_authorization"], "properties": {"formal_heldout_created": {"const": false}, "formal_heldout_content_present": {"const": false}, "status": {"type": "string"}, "custodian_role": {"type": "string"}, "access": {"type": "object", "required": ["may_see_content", "must_not_see_content_before_unseal", "implementer_after_unseal", "reviewer_visibility"], "properties": {"may_see_content": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "must_not_see_content_before_unseal": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "implementer_after_unseal": {"type": "string"}, "reviewer_visibility": {"type": "string"}}, "additionalProperties": false}, "population": {"type": "string"}, "strata": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "sample_frame": {"type": "string"}, "generation_protocol": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "sealing": {"type": "string"}, "manifest_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "case_id": {"type": "string"}, "digests": {"type": "object", "required": ["prompt", "router_input"], "properties": {"prompt": {"type": "string"}, "router_input": {"type": "string"}}, "additionalProperties": false}, "overlap_contamination": {"type": "string"}, "blind_route_gold": {"type": "string"}, "blind_task_outcome": {"type": "string"}, "unknown_handling": {"type": "string"}, "unseal_authorization": {"type": "string"}}, "additionalProperties": false},
    "candidate_registry": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["name", "role", "canonical_repository", "source_commit", "candidate_checkpoint", "checkpoint_revision", "checkpoint_size", "code_license", "model_license", "external_dependencies", "offline_feasibility", "hardware", "chinese_support", "adapter_status", "eligibility"], "properties": {"name": {"enum": ["Laya", "RouteLLM", "vLLM Semantic Router"]}, "role": {"type": "string"}, "canonical_repository": {"type": "string", "format": "uri"}, "source_commit": {"$ref": "#/$defs/identity"}, "candidate_checkpoint": {"type": "string"}, "checkpoint_revision": {"$ref": "#/$defs/identity"}, "checkpoint_size": {"$ref": "#/$defs/evidence"}, "code_license": {"$ref": "#/$defs/evidence"}, "model_license": {"$ref": "#/$defs/evidence"}, "external_dependencies": {"$ref": "#/$defs/evidence"}, "offline_feasibility": {"$ref": "#/$defs/evidence"}, "hardware": {"type": "object", "required": ["cpu", "gpu"], "properties": {"cpu": {"type": "string"}, "gpu": {"type": "string"}}, "additionalProperties": false}, "chinese_support": {"$ref": "#/$defs/evidence"}, "adapter_status": {"type": "string"}, "eligibility": {"type": "string"}}, "additionalProperties": false}},
    "adapter_runner_executor_identity": {"type": "object", "required": ["architecture", "end_to_end_architecture", "routing_contract", "adapter_interface", "adapter_identity", "runner_identity", "executor_identity", "config_identity", "receipt_required_fields", "environment_identity"], "properties": {"architecture": {"type": "array", "minItems": 4, "items": {"type": "string"}}, "end_to_end_architecture": {"type": "array", "minItems": 4, "items": {"type": "string"}}, "routing_contract": {"type": "string"}, "adapter_interface": {"type": "string"}, "adapter_identity": {"type": "string"}, "runner_identity": {"type": "string"}, "executor_identity": {"type": "string"}, "config_identity": {"type": "string"}, "receipt_required_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "environment_identity": {"type": "string"}}, "additionalProperties": false},
    "environment_plan": {"type": "object", "required": ["probes_run_utc_date", "python", "lock_strategy", "wsl", "cpu", "ram", "gpu", "disk", "network_policy", "offline_cache_policy"], "properties": {"probes_run_utc_date": {"type": "string", "format": "date"}, "python": {"type": "string"}, "lock_strategy": {"type": "string"}, "wsl": {"type": "object", "required": ["identity", "effective_limits"], "properties": {"identity": {"type": "string"}, "effective_limits": {"type": "string"}}, "additionalProperties": false}, "cpu": {"type": "string"}, "ram": {"type": "string"}, "gpu": {"type": "string"}, "disk": {"type": "string"}, "network_policy": {"type": "string"}, "offline_cache_policy": {"type": "string"}}, "additionalProperties": false},
    "resource_budget": {"type": "object", "required": ["paid_api_budget", "MAX_MODEL_DOWNLOAD_COUNT", "MAX_MODEL_DOWNLOAD_BYTES", "MAX_DISK_USAGE", "MAX_WALL_CLOCK", "MAX_FULL_BENCHMARK_RERUNS", "MAX_FEASIBILITY_CASES", "USER_APPROVAL_REQUIRED", "budget_state"], "properties": {"paid_api_budget": {"const": 0}, "MAX_MODEL_DOWNLOAD_COUNT": {"$ref": "#/$defs/budget"}, "MAX_MODEL_DOWNLOAD_BYTES": {"$ref": "#/$defs/budget"}, "MAX_DISK_USAGE": {"$ref": "#/$defs/budget"}, "MAX_WALL_CLOCK": {"$ref": "#/$defs/budget"}, "MAX_FULL_BENCHMARK_RERUNS": {"$ref": "#/$defs/budget"}, "MAX_FEASIBILITY_CASES": {"$ref": "#/$defs/budget"}, "USER_APPROVAL_REQUIRED": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "budget_state": {"const": "PROPOSED_NOT_APPROVED; EXECUTION_AUTHORIZED remains false"}}, "additionalProperties": false},
    "stop_conditions": {"type": "array", "minItems": 8, "items": {"type": "object", "required": ["condition", "action"], "properties": {"condition": {"type": "string"}, "action": {"type": "string"}}, "additionalProperties": false}},
    "unresolved_items": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "track": {"type": "object", "required": ["primary_claim", "primary_metric", "secondary_metrics", "paired_case_semantics", "inferential_method_boundary"], "properties": {"primary_claim": {"type": "string"}, "primary_metric": {"type": "string"}, "secondary_metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "paired_case_semantics": {"type": "string"}, "inferential_method_boundary": {"type": "string"}}, "additionalProperties": false},
    "identity": {"type": "object", "required": ["value", "status"], "properties": {"value": {"type": "string"}, "status": {"enum": ["VERIFIED", "UPSTREAM_CLAIM", "UNKNOWN", "NOT_TESTED", "NOT_ELIGIBLE"]}, "evidence": {"type": "string"}}, "additionalProperties": false},
    "evidence": {"type": "object", "required": ["value", "status"], "properties": {"value": {"type": "string"}, "status": {"enum": ["VERIFIED", "UPSTREAM_CLAIM", "UNKNOWN", "NOT_TESTED", "NOT_ELIGIBLE"]}, "evidence": {"type": "string"}}, "additionalProperties": false},
    "budget": {"type": "object", "required": ["proposed", "approved", "basis"], "properties": {"proposed": {"type": "integer", "minimum": 0}, "unit": {"type": "string"}, "approved": {"const": false}, "basis": {"type": "string"}}, "additionalProperties": false}
  }
}
