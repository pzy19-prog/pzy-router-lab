{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pzy19-prog.github.io/pzy-router-lab/schemas/phase1-preregistration.schema.json",
  "title": "Router Lab Phase 1 Stage A preregistration",
  "type": "object",
  "required": [
    "schema_version", "record_kind", "status", "execution_authorized", "repository",
    "branch", "base_commit", "issue", "as_of", "scope", "research_question", "data_plan",
    "sample_size_and_statistics", "metrics", "candidates", "environment", "budget_and_stops",
    "playbook_preflight", "review_gates"
  ],
  "properties": {
    "schema_version": {"const": "phase1-preregistration-v1"},
    "record_kind": {"const": "ROUTER_LAB_PHASE1_STAGE_A_PREREGISTRATION"},
    "status": {"enum": ["READY_FOR_SOL_REVIEW", "BLOCKED"]},
    "execution_authorized": {"const": false},
    "repository": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "base_commit": {"$ref": "#/$defs/sha"},
    "issue": {"type": "string", "format": "uri"},
    "as_of": {"type": "string", "format": "date"},
    "scope": {
      "type": "object",
      "required": ["stage", "purpose", "prohibited", "dev_data"],
      "properties": {
        "stage": {"const": "A"},
        "purpose": {"type": "string", "minLength": 1},
        "prohibited": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "dev_data": {"type": "string", "minLength": 1}
      }
    },
    "research_question": {
      "type": "object",
      "required": ["primary_research_question", "tracks"],
      "properties": {
        "primary_research_question": {"type": "string", "minLength": 1},
        "tracks": {
          "type": "object",
          "required": ["controlled_routing_comparison", "end_to_end_system_comparison", "separation"],
          "properties": {
            "controlled_routing_comparison": {"$ref": "#/$defs/track"},
            "end_to_end_system_comparison": {"$ref": "#/$defs/track"},
            "separation": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "data_plan": {
      "type": "object",
      "required": ["phase0_disposition", "formal_heldout_created", "generation_method", "split_and_access", "leakage_prevention", "identity_and_seal", "gold_and_blinding", "unknown_handling"],
      "properties": {
        "phase0_disposition": {"const": "dev_only_not_heldout"},
        "formal_heldout_created": {"const": false},
        "generation_method": {"type": "object"},
        "split_and_access": {"type": "object"},
        "leakage_prevention": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "identity_and_seal": {"type": "object"},
        "gold_and_blinding": {"type": "object"},
        "unknown_handling": {"type": "object"}
      }
    },
    "sample_size_and_statistics": {"type": "object"},
    "metrics": {
      "type": "object",
      "required": ["controlled_primary", "end_to_end_primary", "secondary", "policy_invariants", "invariant_failure"],
      "properties": {
        "controlled_primary": {"type": "string", "minLength": 1},
        "end_to_end_primary": {"type": "string", "minLength": 1},
        "secondary": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
        "policy_invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "invariant_failure": {"type": "string", "minLength": 1}
      }
    },
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "environment": {"type": "object"},
    "budget_and_stops": {"type": "object"},
    "playbook_preflight": {
      "type": "object",
      "required": ["record", "source_repo", "source_read_head", "authority_state", "accepted_control", "topics", "material_design_change"],
      "properties": {
        "record": {"type": "string", "minLength": 1},
        "source_repo": {"type": "string", "minLength": 1},
        "source_read_head": {"$ref": "#/$defs/sha"},
        "authority_state": {"const": "NO_ADOPTED_CURRENT_RULES"},
        "accepted_control": {"type": "string", "minLength": 1},
        "topics": {"type": "object"},
        "material_design_change": {"type": "string", "minLength": 1}
      }
    },
    "review_gates": {"type": "object"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "track": {"type": "object", "required": ["purpose", "allowed_conclusions", "prohibited_conclusions"], "properties": {"purpose": {"type": "string", "minLength": 1}, "allowed_conclusions": {"type": "array", "items": {"type": "string"}}, "prohibited_conclusions": {"type": "array", "items": {"type": "string"}}}},
    "metric": {
      "type": "object",
      "required": ["name", "unit", "aggregation", "unknown", "tracks"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "aggregation": {"type": "string", "minLength": 1},
        "unknown": {"type": "string", "minLength": 1},
        "tracks": {"type": "array", "items": {"enum": ["Controlled", "End-to-End"]}, "minItems": 1}
      }
    },
    "candidate": {
      "type": "object",
      "required": ["name", "repo", "code_license", "adapter_status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "repo": {"type": "string", "minLength": 1},
        "code_commit_candidate": {"$ref": "#/$defs/sha"},
        "checkpoint_revision_candidate": {"type": "string"},
        "code_license": {"type": "string", "minLength": 1},
        "adapter_status": {"type": "string", "minLength": 1},
        "checkpoint_status": {"type": "string"},
        "chinese_support": {"type": "string"},
        "cpu_local_feasibility": {"type": "string"}
      }
    }
  }
}
