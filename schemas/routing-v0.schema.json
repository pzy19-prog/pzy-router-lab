{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PZY Router Lab request and decision contract v0",
  "description": "Request half of the versioned contract. Decisions are produced by router_lab.rules.route; no automatic execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "complexity", "sensitivity", "risk", "available_targets"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "complexity": {"enum": ["low", "medium", "high", "unknown"]},
    "sensitivity": {"enum": ["public", "confidential"]},
    "risk": {"enum": ["low", "high"]},
    "available_targets": {"type": "array", "uniqueItems": true, "items": {"enum": ["local_small", "local_strong", "cloud_strong"]}},
    "allow_cloud": {"type": "boolean", "default": false}
  }
}
